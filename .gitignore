# Godot 4
.godot/
export_credentials.cfg

# Export output
/build/
/dist/

# Raw generator output, including rejected variants — over a megabyte each.
# tools/make_tile.gd keeps the accepted texture beside them as a 512px .png,
# which IS committed, so the projection can be redone without regenerating art.
/assets/source/textures/*.webp
/assets/source/textures/*.webp.import
/assets/source/textures/*.jpg
/assets/source/textures/*.jpg.import

# Rejected variants, kept locally until the sprite has been seen in-game.
/assets/source/rejects/

# tools/recraft.py: raw multi-variant Recraft output, one subdirectory per manifest
# subject id. Only the accepted variant (assets/source/<id>/accepted.*) is
# committed; the numbered v1/v2/... variants it was chosen from are not.
/assets/source/**/v[0-9]*.png
/assets/source/**/v[0-9]*.jpg
/assets/source/**/v[0-9]*.jpeg
/assets/source/**/v[0-9]*.webp
/assets/source/.spend.log

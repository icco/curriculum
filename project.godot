; Engine configuration file.
; Generated by hand for the Loopwood High project.

config_version=5

[application]

config/name="Loopwood High"
config/description="A 2.5D isometric turn-based tactical roguelike set in a time-looping high school."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"
boot_splash/show_image=false

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.04, 0.045, 0.06, 1)
